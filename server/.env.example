# Database
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://aprep_user:your_password@localhost:5432/aprep_db
# SQLite (for development/testing only)
# DATABASE_URL=sqlite:///./aprep.db

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama2
OLLAMA_API_KEY= # Ollama API key (optional)
# Security
ENCRYPTION_KEY=your-encryption-key-here-generate-with-fernet
JWT_SECRET_KEY=your-jwt-secret-key-here-generate-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7

# Application Settings
MAX_QUESTIONS_PER_SLOT=10
MAX_TRAIT_TESTS=10
DEFAULT_TIMEOUT_SECONDS=30