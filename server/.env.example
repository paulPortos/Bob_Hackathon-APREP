APP_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG
DATABASE_URL=postgresql+psycopg2://aprep_user:change-me@localhost:5432/aprep_db
ENCRYPTION_KEY=replace-with-a-fernet-key
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_DAYS=7
JWT_ISSUER=aprep-api
JWT_AUDIENCE=aprep-client
OLLAMA_BASE_URL=
OLLAMA_DEFAULT_MODEL=llama3.1
OLLAMA_API_KEY=
DEFAULT_TIMEOUT_SECONDS=30
MAX_REQUEST_BODY_BYTES=1048576
MAX_AGENT_RESPONSE_BYTES=524288
MAX_QUESTIONS_PER_SLOT=10
MAX_TRAIT_TESTS=10
MAX_PROJECTS_PER_USER=2
CORS_ORIGINS=*
ALLOWED_HOSTS=*
AGENT_ENDPOINT_ALLOWED_HOSTS=
ENABLE_DIAGNOSTIC_ROUTES=true
BASE_URL=
KEEP_ALIVE_ENABLED=false
KEEP_ALIVE_INTERVAL_MINUTES=14
RATE_LIMIT_REQUESTS_PER_MINUTE=40
EVALUATIONS_PER_IP_PER_DAY=1
TRUSTED_PROXY_COUNT=0
TRUSTED_PROXY_IPS=
IP_HASH_SALT=
ABUSE_RECORD_RETENTION_DAYS=7
